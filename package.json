{
  "name": "mypi-by-sl",
  "displayName": "MYPI-by-SL",
  "description": "Full AI coding agent inside VS Code - powered by SL's PI",
  "version": "0.3.22",
  "publisher": "sl",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/mypi-by-sl"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onView:mypi-by-sl.catChat",
    "onCommand:mypi-by-sl.openChat",
    "onCommand:mypi-by-sl.setApiKey",
    "onCommand:mypi-by-sl.explainFile",
    "onCommand:mypi-by-sl.explainSelection",
    "onCommand:mypi-by-sl.fixSelection",
    "onCommand:mypi-by-sl.refactorSelection",
    "onCommand:mypi-by-sl.selfTest"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mypi-by-sl.openChat",
        "title": "MYPI-by-SL: Open Chat"
      },
      {
        "command": "mypi-by-sl.setApiKey",
        "title": "MYPI-by-SL: Set API Key"
      },
      {
        "command": "mypi-by-sl.explainFile",
        "title": "MYPI-by-SL: Explain this file"
      },
      {
        "command": "mypi-by-sl.explainSelection",
        "title": "MYPI-by-SL: Explain selection"
      },
      {
        "command": "mypi-by-sl.fixSelection",
        "title": "MYPI-by-SL: Fix selection"
      },
      {
        "command": "mypi-by-sl.refactorSelection",
        "title": "MYPI-by-SL: Refactor selection"
      },
      {
        "command": "mypi-by-sl.selfTest",
        "title": "MYPI-by-SL: Self Test"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mypi-cat-sidebar",
          "title": "MYPI-by-SL",
          "icon": "assets/cat-icon.svg"
        }
      ]
    },
    "views": {
      "mypi-cat-sidebar": [
        {
          "type": "webview",
          "id": "mypi-by-sl.catChat",
          "name": "MYPI CODE"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "mypi-by-sl.explainFile",
          "group": "mypi-by-sl",
          "when": "resource"
        }
      ],
      "editor/context": [
        {
          "command": "mypi-by-sl.explainSelection",
          "group": "mypi-by-sl",
          "when": "editorHasSelection"
        },
        {
          "command": "mypi-by-sl.fixSelection",
          "group": "mypi-by-sl",
          "when": "editorHasSelection"
        },
        {
          "command": "mypi-by-sl.refactorSelection",
          "group": "mypi-by-sl",
          "when": "editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "MYPI-by-SL",
      "properties": {
        "mypi-by-sl.provider": {
          "type": "string",
          "default": "anthropic",
          "enum": [
            "anthropic",
            "openai",
            "deepseek",
            "z-ai",
            "together"
          ],
          "description": "LLM provider (Anthropic, OpenAI, DeepSeek, Z.AI, or Together AI)"
        },
        "mypi-by-sl.model": {
          "type": "string",
          "default": "",
          "description": "Model ID (leave empty for provider default)"
        },
        "mypi-by-sl.apiEndpoint": {
          "type": "string",
          "default": "",
          "description": "Override API base URL (leave empty for provider default)"
        },
        "mypi-by-sl.maxTokens": {
          "type": "number",
          "default": 8192,
          "description": "Maximum tokens per response"
        },
        "mypi-by-sl.toolTimeout": {
          "type": "number",
          "default": 120,
          "description": "Maximum seconds for bash commands"
        },
        "mypi-by-sl.context7ApiKey": {
          "type": "string",
          "default": "",
          "description": "Context7 API key for the docs tool (free key at context7.com/dashboard). Falls back to CONTEXT7_API_KEY env var or ~/.pi/agent/context7-key.txt"
        },
        "mypi-by-sl.thinkingLevel": {
          "type": "string",
          "default": "high",
          "enum": [
            "off",
            "low",
            "medium",
            "high"
          ],
          "description": "Model reasoning effort (matches PI's defaultThinkingLevel). 'off' disables extended thinking"
        },
        "mypi-by-sl.skillsPath": {
          "type": "string",
          "default": "",
          "description": "Override skill directory (empty = use bundled)"
        },
        "mypi-by-sl.braveSearchApiKey": {
          "type": "string",
          "default": "",
          "description": "Brave Search API key for the web_search tool (free 2k queries/month at brave.com/search/api). Falls back to BRAVE_SEARCH_API_KEY env var or ~/.pi/agent/brave-key.txt"
        },
        "mypi-by-sl.webAllowedDomains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Domains web_fetch may access without prompting, e.g. [\"docs.z.ai\", \"*.anthropic.com\"]. Private and internal addresses are always blocked regardless."
        },
        "mypi-by-sl.webBlockedDomains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Domains web_fetch may never access. Checked before the allow list."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build-webview",
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json",
    "build-webview": "node esbuild.js",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "copy-skills:dev": "set MYPI_DEV=1 && node scripts/copy-skills.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.19.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "playwright": "^1.61.1"
  },
  "allowScripts": {
    "esbuild@0.19.12": true
  }
}
